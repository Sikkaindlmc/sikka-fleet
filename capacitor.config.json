{
  "appId": "com.sikkaind.sikkafleet",
  "appName": "Sikka Fleet",
  "webDir": "frontend/out",
  "server": {
    "url": "https://sikka-fleet.vercel.app",
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": true,
    "allowNavigation": [
      "sikka-fleet.vercel.app",
      "*.vercel.app",
      "fleet.sikkaind.com",
      "*.sikkaind.com"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": true,
    "allowsLinkPreview": false,
    "limitsNavigationsToAppBoundDomains": false
  }
}