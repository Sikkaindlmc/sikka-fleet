PORT=5000
NODE_ENV=production
JWT_SECRET=your_strong_random_jwt_secret_min_32_characters
# Keep real values in backend/.env locally and in the host's secret manager; never commit them.
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sikka_fleet?retryWrites=true&w=majority
MONGODB_DIRECT_URI=
MONGODB_DB_NAME=sikka_fleet
CRON_SECRET=your_strong_random_cron_secret_key
WHEELSEYE_API_URL=https://api.wheelseye.com/currentLoc
WHEELSEYE_API_KEY=replace_with_wheelseye_access_token
WHEELSEYE_ACCESS_TOKEN=
GPS_CREDENTIAL_ENCRYPTION_KEY=replace_with_32_byte_hex_or_base64_key
GPS_RAW_SAMPLE_LOGGING=false
GPS_SCHEDULER_MODE=server
GPS_STALE_THRESHOLD_MINUTES=30
GPS_REPORT_MAX_GAP_MINUTES=90
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000
