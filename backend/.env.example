PORT=5000
NODE_ENV=production
JWT_SECRET=your_strong_random_jwt_secret_min_32_characters
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sikka_fleet?retryWrites=true&w=majority
MONGODB_DB_NAME=sikka_fleet
CRON_SECRET=your_strong_random_cron_secret_key
WHEELSEYE_API_URL=https://api.wheelseye.com/currentLoc?accessToken=your_wheelseye_access_token
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000
