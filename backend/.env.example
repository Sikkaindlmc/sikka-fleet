PORT=5000
JWT_SECRET=your_jwt_secret_key
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sikka_fleet
CRON_SECRET=your_cron_secret_key

# WheelsEye GPS Configuration
WHEELSEYE_API_URL=https://api.wheelseye.com/currentLoc?accessToken=YOUR_WHEELSEYE_TOKEN
WHEELSEYE_ACCESS_TOKEN=YOUR_WHEELSEYE_TOKEN

# FleetX GPS Configuration
FLEETX_API_BASE_URL=https://api.fleetx.io
FLEETX_BASIC_AUTH=Basic YOUR_FLEETX_BASE64_BASIC_AUTH
FLEETX_USERNAME=YOUR_FLEETX_USERNAME
FLEETX_PASSWORD=YOUR_FLEETX_PASSWORD

ALLOWED_ORIGINS=*
NODE_ENV=development
